    "dataset_spec": {
      "name": "uci_bone_marrow",
      "description": "UCI Bone marrow transplant: children (Wroclaw, 2000-2015; 187 paediatric allogeneic unrelated-donor haematopoietic stem cell transplants). 35 donor, recipient, graft and post-transplant course predictors (several post-transplant events are included in the source table). Binary death during follow-up.",
      "file": "patients.csv",
      "separator": ",",
      "id_column": "record_id",
      "pseudonymize": false,
      "setting": "Child or adolescent with a malignant or non-malignant haematological disease who received an allogeneic haematopoietic stem cell transplant from an unrelated donor at a paediatric transplant centre (Wroclaw, Poland, 2000-2015). The observations are donor and recipient characteristics, blood-group, cytomegalovirus and HLA compatibility, graft cell doses, and the recorded post-transplant course (engraftment times, graft-versus-host disease and relapse).",
      "observations_header": "Transplant record:",
      "predictors": {
        "recipientgender": {
          "column": "recipientgender",
          "kind": "categorical",
          "text_label": "Recipient sex",
          "text_values": {
            "0": "Female",
            "1": "Male"
          }
        },
        "stemcellsource": {
          "column": "stemcellsource",
          "kind": "categorical",
          "text_label": "Stem cell source",
          "text_values": {
            "0": "Bone marrow",
            "1": "Peripheral blood"
          }
        },
        "donorage": {
          "column": "donorage",
          "kind": "numeric",
          "text_label": "Donor age at apheresis",
          "unit": "years"
        },
        "donorage35": {
          "column": "donorage35",
          "kind": "categorical",
          "text_label": "Donor age category",
          "text_values": {
            "0": "Under 35 years",
            "1": "35 years or older"
          }
        },
        "iiiv": {
          "column": "iiiv",
          "kind": "categorical",
          "text_label": "Acute graft-versus-host disease grade II-IV developed",
          "text_values": {
            "0": "No",
            "1": "Yes"
          }
        },
        "gendermatch": {
          "column": "gendermatch",
          "kind": "categorical",
          "text_label": "Donor-recipient sex combination",
          "text_values": {
            "0": "Other combination",
            "1": "Female donor to male recipient"
          }
        },
        "donorabo": {
          "column": "donorabo",
          "kind": "categorical",
          "text_label": "Donor ABO blood group",
          "text_values": {
            "0": "O",
            "1": "A",
            "-1": "B",
            "2": "AB"
          }
        },
        "recipientabo": {
          "column": "recipientabo",
          "kind": "categorical",
          "text_label": "Recipient ABO blood group",
          "text_values": {
            "0": "O",
            "1": "A",
            "-1": "B",
            "2": "AB"
          }
        },
        "recipientrh": {
          "column": "recipientrh",
          "kind": "categorical",
          "text_label": "Recipient Rh factor",
          "text_values": {
            "0": "Rh negative",
            "1": "Rh positive"
          }
        },
        "abomatch": {
          "column": "abomatch",
          "kind": "categorical",
          "text_label": "Donor-recipient ABO compatibility",
          "text_values": {
            "0": "Mismatched",
            "1": "Matched"
          }
        },
        "cmvstatus": {
          "column": "cmvstatus",
          "kind": "categorical",
          "text_label": "Donor-recipient cytomegalovirus serological compatibility score",
          "text_values": {
            "0": "0 of 3 (most compatible)",
            "1": "1 of 3",
            "2": "2 of 3",
            "3": "3 of 3 (least compatible)"
          }
        },
        "donorcmv": {
          "column": "donorcmv",
          "kind": "categorical",
          "text_label": "Donor cytomegalovirus infection before transplant",
          "text_values": {
            "0": "Absent",
            "1": "Present"
          }
        },
        "recipientcmv": {
          "column": "recipientcmv",
          "kind": "categorical",
          "text_label": "Recipient cytomegalovirus infection before transplant",
          "text_values": {
            "0": "Absent",
            "1": "Present"
          }
        },
        "disease": {
          "column": "disease",
          "kind": "categorical",
          "text_label": "Underlying disease",
          "text_values": {
            "ALL": "Acute lymphoblastic leukaemia",
            "AML": "Acute myeloid leukaemia",
            "chronic": "Chronic leukaemia",
            "nonmalignant": "Non-malignant disease",
            "lymphoma": "Lymphoma"
          }
        },
        "riskgroup": {
          "column": "riskgroup",
          "kind": "categorical",
          "text_label": "Risk group",
          "text_values": {
            "0": "Low risk",
            "1": "High risk"
          }
        },
        "txpostrelapse": {
          "column": "txpostrelapse",
          "kind": "categorical",
          "text_label": "Second transplant after relapse",
          "text_values": {
            "0": "No",
            "1": "Yes"
          }
        },
        "diseasegroup": {
          "column": "diseasegroup",
          "kind": "categorical",
          "text_label": "Disease group",
          "text_values": {
            "0": "Non-malignant",
            "1": "Malignant"
          }
        },
