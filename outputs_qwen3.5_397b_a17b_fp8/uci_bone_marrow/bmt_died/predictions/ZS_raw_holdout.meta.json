          "column": "hlamatch",
          "kind": "categorical",
          "text_label": "HLA match (BFM SCT 2008 criteria)",
          "text_values": {
            "0": "10/10 matched",
            "1": "9/10 matched",
            "2": "8/10 matched",
            "3": "7/10 matched"
          }
        },
        "hlamismatch": {
          "column": "hlamismatch",
          "kind": "categorical",
          "text_label": "HLA mismatch present",
          "text_values": {
            "0": "Matched",
            "1": "Mismatched"
          }
        },
        "antigen": {
          "column": "antigen",
          "kind": "categorical",
          "text_label": "Number of HLA antigen differences between donor and recipient",
          "text_values": {
            "-1": "No antigen difference",
            "0": "One antigen difference",
            "1": "Two antigen differences",
            "2": "Three antigen differences"
          }
        },
        "allele": {
          "column": "allele",
          "kind": "categorical",
          "text_label": "Number of HLA allele differences between donor and recipient",
          "text_values": {
            "-1": "No allele difference",
            "0": "One allele difference",
            "1": "Two allele differences",
            "2": "Three allele differences",
            "3": "Four allele differences"
          }
        },
        "hlagri": {
          "column": "hlagri",
          "kind": "categorical",
          "text_label": "Type of HLA difference",
          "text_values": {
            "0": "HLA matched",
